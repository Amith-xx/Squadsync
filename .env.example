# ──────────────────────────────────────────────────────────────────────────────
# SquadSync — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32  OR  npx auth secret
NEXTAUTH_SECRET=your_nextauth_secret_here
# Required in production — set to your Vercel deployment URL
# e.g. https://squadsync.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod):  https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB Atlas free tier: cluster0.xxxxx.mongodb.net
# Add your Vercel IPs (or 0.0.0.0/0 for demo) to Atlas Network Access
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/squadsync?retryWrites=true&w=majority

# ─── Pusher (Server-side — NEVER expose to client) ───────────────────────────
# Create app at: dashboard.pusher.com → Create App
# Enable "Client Events" in App Settings (required for presence channels)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2

# ─── Pusher (Client-side — public, safe to expose) ───────────────────────────
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
